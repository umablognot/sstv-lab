msgid "rx.error.generic"
msgstr "تعذّر تشغيل الميكروفون. حاول مرة أخرى باستخدام Safari أو Chrome محدّث."

msgid "rx.signal.loud"
msgstr "الصوت مرتفع جدًا. اخفض قليلًا مستوى صوت جهاز الإرسال."

msgid "rx.signal.quiet"
