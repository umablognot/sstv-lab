msgid "rx.hint.building"
msgstr "Spiele den Ton ohne Unterbrechung bis zum Ende ab. Halte den Bildschirm wach."

msgid "rx.status.incomplete"
msgstr "Einige Zeilen wurden nicht empfangen"

msgid "rx.hint.incomplete"
