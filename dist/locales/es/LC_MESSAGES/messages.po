msgid "tx.status.sending"
msgstr "La foto se está enviando como sonido. No reproduzcas otros sonidos en segundo plano."

msgid "tx.status.done"
msgstr "Sonido terminado. Comprueba en el teléfono que la foto fue recibida."

msgid "tx.status.resend"
msgstr "Listo. Puedes enviar la foto otra vez."

msgid "tx.status.wav"
msgstr "WAV listo: 16 kHz · mono · PCM de 16 bits."

