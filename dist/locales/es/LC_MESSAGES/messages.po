msgstr "Transferencia por código QR"

msgid "dv.qr.desc"
msgstr "La foto se divide en códigos QR consecutivos. Apunta la cámara del otro dispositivo a la pantalla — silencioso y totalmente sin conexión."

msgid "dv.qr.send"
msgstr "Enviar con QR"

msgid "dv.qr.stop"
msgstr "Detener flujo QR"

msgid "dv.qr.receive"
msgstr "Recibir con la cámara"

msgid "dv.qr.receiveStop"
msgstr "Detener cámara"

