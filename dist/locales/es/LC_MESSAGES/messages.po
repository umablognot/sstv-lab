msgstr "No se pudo decodificar el sonido. Reinicia la escucha."

msgid "rx.error.worker"
msgstr "No se pudo iniciar el procesador de audio. Recarga la página e inténtalo de nuevo."

msgid "rx.error.secure"
msgstr "Para el micrófono, abre esta página por HTTPS con Safari o Chrome. Una dirección http:// en la red local no permite el micrófono en el teléfono."

msgid "rx.error.notallowed"
msgstr "No se concedió el permiso del micrófono. Permite el micrófono en los ajustes del sitio en el navegador e inténtalo de nuevo."

msgid "rx.error.notfound"
msgstr "No se encontró micrófono. Abre esta página en un teléfono o ordenador con micrófono."

msgid "rx.error.notreadable"
msgstr "No se pudo abrir el micrófono. Cierra otras apps que lo usen e inténtalo de nuevo."

msgid "rx.error.generic"
msgstr "El micrófono no pudo iniciarse. Inténtalo con un Safari o Chrome actualizado."

msgid "rx.signal.loud"
msgstr "El sonido es demasiado fuerte. Baja un poco el volumen del dispositivo emisor."

msgid "rx.signal.quiet"
msgstr "Llega muy poco sonido. Acerca el dispositivo al altavoz."

msgid "rx.signal.receiving"
msgstr "Recibiendo sonido. Transferencia en curso."

msgid "rx.signal.open"
msgstr "Micrófono activo. Esperando la señal de inicio de Robot36."

