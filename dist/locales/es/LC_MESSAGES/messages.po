msgstr "Apagado"

msgid "rx.level.silent"
msgstr "Muy silencioso"

msgid "rx.hint.security"
msgstr "El micrófono se activa solo cuando pulsas el botón."

msgid "rx.hint.off"
msgstr "Micrófono apagado. No se está grabando audio."

