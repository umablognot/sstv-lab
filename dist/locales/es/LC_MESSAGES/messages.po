msgid "dv.qr.frameOf"
msgstr "Mostrando fotograma {index} / {frames}"

msgid "dv.qr.needPhoto"
msgstr "Primero elige una foto en la pestaña «Enviar foto»."

msgid "dv.qr.generating"
msgstr "Preparando fotogramas QR…"

msgid "dv.qr.noCamera"
msgstr "No se pudo abrir la cámara."

